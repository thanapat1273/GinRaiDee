# Copy to .env and fill in. .env is git-ignored; never commit real keys.

# Local Postgres (docker compose). Bound to 127.0.0.1 only.
POSTGRES_PASSWORD=ginraidee_local
DATABASE_URL=postgres://ginraidee:ginraidee_local@127.0.0.1:5433/ginraidee

# Optional: enables smarter chat parsing and persona replies.
# Create at https://aistudio.google.com/apikey (use a paid-tier project so data isn't used for training).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite

# Optional: real shops, Google Maps link lookup, open-now status.
# Google Cloud project with billing enabled + "Places API (New)" enabled.
# Restrict the key to Places API (New) and set a daily quota so it can't exceed the free caps.
GOOGLE_PLACES_API_KEY=

API_PORT=8787
